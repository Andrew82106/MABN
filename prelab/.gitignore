# Public-release boundary: retain source, protocols, reports and manifests;
# keep local model/data products out of Git.
**/.venv/
**/venv/
**/.cache/
**/models/
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.ckpt
**/*.gguf
**/*.npy
**/*.npz
**/*.pkl
**/*.pickle
**/*.joblib
**/*.arrow
**/*.parquet
**/checkpoints/
**/matrices/
**/scores/
**/logs/
**/*predictions*.jsonl
**/*.jsonl.pending
**/*.jsonl.partial
**/FAILED_*_SNAPSHOT.py
**/testing_utils.py

# Raw/derived arrays and intermediate line-oriented datasets are reproducible
# from the checked-in scripts and manifests, but too large for ordinary Git.
**/data/raw/
**/data/features/
**/data/*/features/
**/*.jsonl

# Large generated JSON summaries and serialized input/output snapshots are
# regenerated by the scripts.  Keep only named small manifests/protocols.
**/*.json
!**/manifest.json
!**/*manifest*.json
!**/*protocol*.json
!**/AUDIT.json
!**/*AUDIT*.json
!**/REPORT.json
!**/model_ready.json
!**/*.source.json

# Rendered previews and compressed intermediate traces.
**/*.html
**/*.png
**/*.ipynb
**/*.zip
**/*.gz

# Vendored upstream repositories are referenced by commit and URL in the
# manifests; keeping full clones here duplicates large dependency trees.
benchmark_ragtruth_qa/third_party/
benchmark_ragtruth_qa/semantic_baseline/
