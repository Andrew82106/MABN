**/*.bin
**/*.pt
**/*.pth
**/*.ckpt
**/*.gguf
**/*.npy
**/*.npz
**/*.pkl
**/*.pickle
**/*.joblib
**/*.arrow
**/*.parquet

# Generated experiment products and raw line-oriented data.
**/checkpoints/
**/matrices/
**/scores/
**/logs/
**/*predictions*.jsonl
**/*.jsonl.pending
**/*.jsonl.partial
**/FAILED_*_SNAPSHOT.py
