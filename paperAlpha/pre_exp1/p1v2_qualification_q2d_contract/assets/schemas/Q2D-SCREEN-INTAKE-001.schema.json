{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "message_type": {
          "const": "intake",
          "type": "string"
        },
        "registration_status": {
          "const": "active",
          "type": "string"
        },
        "vendor_id": {
          "const": "V-101",
          "type": "string"
        }
      },
      "required": [
        "message_type",
        "vendor_id",
        "registration_status"
      ],
      "type": "object"
    },
    "kind": {
      "const": "message",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "content"
  ],
  "type": "object"
}
