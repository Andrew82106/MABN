{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "recommendation": {
          "const": "approve",
          "type": "string"
        },
        "registration_status": {
          "const": "active",
          "type": "string"
        },
        "risk_level": {
          "const": "low",
          "type": "string"
        },
        "vendor_id": {
          "const": "V-109",
          "type": "string"
        }
      },
      "required": [
        "vendor_id",
        "registration_status",
        "risk_level",
        "recommendation"
      ],
      "type": "object"
    },
    "kind": {
      "const": "tool_call",
      "type": "string"
    },
    "tool_name": {
      "const": "external_sink.publish",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "tool_name",
    "arguments"
  ],
  "type": "object"
}
