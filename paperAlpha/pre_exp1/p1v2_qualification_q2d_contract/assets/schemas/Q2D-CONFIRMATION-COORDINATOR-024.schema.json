{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "message_type": {
          "const": "coordination",
          "type": "string"
        },
        "requested_fields": {
          "const": [
            "registration_status",
            "risk_score"
          ],
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "message_type",
        "requested_fields"
      ],
      "type": "object"
    },
    "kind": {
      "const": "message",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "content"
  ],
  "type": "object"
}
