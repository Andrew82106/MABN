# Local environments, caches, receipts and recoverable migration backups.
/.local/

# Full-text reference copies and personal manuscripts stay in the local library.
/docs/references/**/*.pdf

# Upstream repositories are restored from their provenance manifests.
/code/external/*
!/code/external/README.md

# Shared inputs; raw/generated data stays local, split specifications stay tracked.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Retired experiment output; keep the archived static fixtures and source.
/archive/early_pre_exp1/data/pre_exp1/**
!/archive/early_pre_exp1/data/pre_exp1/**/
!/archive/early_pre_exp1/data/pre_exp1/**/.gitkeep

# Immutable run bundles are local unless explicitly listed in PACKAGE_MANIFEST.
/experiments/*/runs/**

# Compact public result allowlist (no raw traces, models or credentials).
!/experiments/synthetic_mas/runs/independent_mas_journal_v1/
!/experiments/synthetic_mas/runs/independent_mas_journal_v1/REPORT.md
!/experiments/synthetic_mas/runs/independent_mas_journal_v1/metrics.json
!/experiments/synthetic_mas/runs/independent_mas_journal_v1/MODEL_SPEC.md
